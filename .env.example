# Copy to .env and fill in real values locally. Never commit .env.
# On Windows, save this file as UTF-8 (not the PowerShell default UTF-16) —
# use VS Code or Git Bash, or `Set-Content -Encoding utf8` if scripting it.

# ── Database (Neon Postgres) ─────────────────────────────────────────
# Runtime connection — used by the deployed app (Hostinger) via the pg
# driver adapter in src/lib/db.ts. MUST be Neon's POOLED connection string
# (contains "-pooler" in the hostname). Hostinger's IPv6 routing to Neon's
# direct endpoint is broken; the pooled endpoint works around it.
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.eu-central-1.aws.neon.tech/entreprenadjobb?sslmode=require"

# CLI-only connection — used by `prisma migrate`/`generate`/`studio`/`seed`
# via prisma.config.ts. MUST be Neon's DIRECT (non-pooled) connection string.
# Run all `prisma migrate` commands LOCALLY on Windows, never on Hostinger.
DIRECT_URL="postgresql://user:password@ep-xxxx.eu-central-1.aws.neon.tech/entreprenadjobb?sslmode=require"

# ── Auth.js (email magic links) ──────────────────────────────────────
AUTH_SECRET="generate-with-npx-auth-secret"
AUTH_URL="http://localhost:3000"

# ── Email (Resend, custom domain) ────────────────────────────────────
RESEND_API_KEY="re_xxxxxxxx"
EMAIL_FROM="Entreprenadjobb <noreply@entreprenadjobb.se>"

# ── Aggregator cron (GitHub Actions -> /api/aggregator/run) ──────────
CRON_SECRET="generate-a-long-random-string"

# ── JobTech / Platsbanken (Phase 2) ───────────────────────────────────
JOBTECH_API_KEY=""

# ── Analytics (Phase 4) ───────────────────────────────────────────────
NEXT_PUBLIC_GA_ID=""
